# Copy this file to .env and fill in real values. .env is gitignored.

# --- Apify (lead sourcing) ---
APIFY_API_TOKEN=
# Default actor to run if a profile doesn't specify its own apify.actor_id
APIFY_ACTOR_ID=microworlds/leads-finder

# --- Gemini (email generation) ---
GEMINI_API_KEY=
# gemini-3.1-pro-preview typically needs billing enabled on your Google
# Cloud project for any quota at all; flash-lite is a solid free-tier
# default for straightforward tasks like this. Swap back to a Pro model
# once billing is on if you want higher-quality copy.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Google Sheets + Gmail (shared OAuth client) ---
GOOGLE_OAUTH_CLIENT_SECRET_FILE=config/google_oauth_client_secret.json
GOOGLE_TOKEN_FILE=config/google_token.json
GOOGLE_SHEET_ID=

# --- Gmail sender identity ---
GMAIL_SENDER_ADDRESS=

# --- GitHub (only needed if you want the agent to push for you) ---
GITHUB_TOKEN=
GITHUB_REPO_NAME=lead-gen-agent
GITHUB_VISIBILITY=private
